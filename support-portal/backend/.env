# Environment Configuration for Support Portal Backend
# Copy this file to .env and update with your actual values

# Database Configuration
# DATABASE_URL=postgresql://username:password@localhost:5432/support_portal
DATABASE_URL=
SQLITE_DB_PATH=support_portal.db

# AWS S3 Configuration (optional - will use local storage if not provided)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=uploads

# Authentication (for development)
DEFAULT_USER_ID=demo-user

# Server Configuration
PORT=8000
DEBUG=true

# Slack Bot Configuration
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Email Notification Configuration
# For Gmail: Enable 2FA and create App Password at https://myaccount.google.com/apppasswords
# Console Mode: Set to 'true' to log emails instead of sending (no SMTP setup needed)
EMAIL_CONSOLE_MODE=true
EMAIL_LOG_FILE=email_notifications.log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dheeraj.narayanam@payintelli.com
SMTP_PASSWORD=
FROM_EMAIL=dheeraj.narayanam@payintelli.com
FROM_NAME=Support Portal

# Multi-Client Slack Channels (optional - leave empty to use default channel for all)
SLACK_CHANNEL_TECHCORP=
SLACK_CHANNEL_SHOPIFYPLUS=
SLACK_CHANNEL_FINANCEONE=